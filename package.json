{
  "name": "agent-skill",
  "version": "0.3.0",
  "description": "别人管「装」，我们管「装之前和跑之后」：技能安装前准入、运行时权限上限与可验证证据链。",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.23.2"
  },
  "bin": {
    "agent-skill": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/claude.d.ts",
      "import": "./dist/adapter/claude.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node dist/cli/index.js"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/semver": "^7.7.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
